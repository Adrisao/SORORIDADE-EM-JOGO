rules_version = '2';

// Regras de segurança do Firestore do Sororidade em Jogo.
// Publicar no Firebase: firebase deploy --only firestore:rules
service cloud.firestore {
  match /databases/{database}/documents {

    // Cada aluna só acessa a própria pasta: alunas/{uid}/...
    match /alunas/{uid}/tentativas/{tentativa} {
      allow read: if request.auth != null && request.auth.uid == uid;

      // Só pode criar (nunca editar ou apagar) e com os campos certos.
      allow create: if request.auth != null
        && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['lesson_id', 'erros', 'data', 'criadoEm'])
        && request.resource.data.lesson_id is int
        && request.resource.data.lesson_id >= 1
        && request.resource.data.lesson_id <= 1000
        && request.resource.data.erros is int
        && request.resource.data.erros >= 0
        && request.resource.data.erros <= 1000
        && request.resource.data.data is string
        && request.resource.data.data.size() <= 40
        && request.resource.data.criadoEm == request.time;
    }

    // Perfil da aluna: avatar, roupinhas compradas, gemas gastas e configurações.
    match /alunas/{uid} {
      allow read: if request.auth != null && request.auth.uid == uid;

      allow create, update: if request.auth != null
        && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(
             ['avatar', 'roupa', 'acessorio', 'compradas', 'gemasGastas', 'som',
              'xp', 'gemasMissoes', 'missoesResgatadas', 'diaDasDiarias', 'diariasResgatadas'])
        && request.resource.data.avatar is string
        && request.resource.data.avatar.size() <= 40
        && request.resource.data.roupa is string
        && request.resource.data.roupa.size() <= 40
        && (request.resource.data.acessorio == null
            || (request.resource.data.acessorio is string
                && request.resource.data.acessorio.size() <= 40))
        && request.resource.data.compradas is list
        && request.resource.data.compradas.size() <= 100
        && request.resource.data.gemasGastas is int
        && request.resource.data.gemasGastas >= 0
        // Gemas gastas nunca diminuem (não dá para "devolver" e ganhar de novo).
        && (resource == null || request.resource.data.gemasGastas >= resource.data.gemasGastas)
        && request.resource.data.som is bool
        // Missões: XP e gemas das missões só aumentam, e no máximo 300 por vez
        // (a maior recompensa é 200 XP), para não dar para inventar pontos.
        && request.resource.data.xp is int
        && request.resource.data.xp >= 0
        && request.resource.data.gemasMissoes is int
        && request.resource.data.gemasMissoes >= 0
        && (resource == null
            ? (request.resource.data.xp <= 300 && request.resource.data.gemasMissoes <= 300)
            : (request.resource.data.xp >= resource.data.get('xp', 0)
               && request.resource.data.xp <= resource.data.get('xp', 0) + 300
               && request.resource.data.gemasMissoes >= resource.data.get('gemasMissoes', 0)
               && request.resource.data.gemasMissoes <= resource.data.get('gemasMissoes', 0) + 300))
        && request.resource.data.missoesResgatadas is list
        && request.resource.data.missoesResgatadas.size() <= 50
        && request.resource.data.diaDasDiarias is string
        && request.resource.data.diaDasDiarias.size() <= 10
        && request.resource.data.diariasResgatadas is list
        && request.resource.data.diariasResgatadas.size() <= 20;
    }

    // Qualquer outro caminho fica bloqueado.
    match /{caminho=**} {
      allow read, write: if false;
    }
  }
}
